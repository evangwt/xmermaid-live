{
  "name": "xmermaid-live",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:wasm": "node scripts/copy-xmermaid-wasm.mjs",
    "dev": "npm run copy:wasm && vite",
    "build": "npm run copy:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "review:snapshot": "node scripts/review-snapshot.mjs",
    "serve:test": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test && npm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@evangwt/xmermaid": "0.1.9",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
